# Supabase is wired up but unused. Both variables are OPTIONAL: Surfaced builds
# and runs with no environment set at all. When absent, the Supabase clients in
# lib/supabase return null and callers degrade gracefully.
#
# NEXT_PUBLIC_SUPABASE_URL must be a well-formed https:// URL. It is parsed with
# `new URL()` and rejected if it does not parse — never string-concatenated.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
